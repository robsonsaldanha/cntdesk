{
  "productName": "CNT Desk",
  "identifier": "com.cntdesk.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "bundle": {
		"active": true,
		"icon": [
			"icons/icon.png",
			"icons/icon.ico"
		]
	},
	"app": {
    "windows": [
      {
        "title": "CNT Desk",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  }
}